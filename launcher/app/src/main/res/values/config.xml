<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Background effects. 2 = full (60 fps drift, blur), 1 = reduced (the drift steps 8 times a
         second; blur and glow stay), 0 = off (still background, no blur).
         Set to 1 on 2026-10-26: this Bravia has 2.9 GB of RAM but only about 1.2 GB available. -->
    <integer name="effects">1</integer>

    <!-- Apps per row in the dock. -->
    <integer name="columns">6</integer>

    <!-- The dock holds every app. These lead, in order (package names); missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>org.smarttube.stable</item>
        <item>in.startv.hotstar</item>
        <item>ahaflix.tv</item>
        <item>com.cricfytv.sports</item>
    </string-array>

    <!-- Weather card location (Open-Meteo; change to your town) -->
    <string name="weather_lat">17.385</string>
    <string name="weather_lon">78.487</string>
    <string name="weather_place">Hyderabad</string>

    <!-- These follow the apps above, in order; every other app follows A to Z. -->
    <string-array name="grid_apps">
        <item>com.sonyliv</item>
        <item>com.graymatrix.did</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.yablio.sendfilestotv</item>
        <item>com.android.vending</item>
        <item>com.sony.dtv.tvx</item>
    </string-array>

    <!-- Apps to hide from the grid (they stay installed). Example:
         <item>com.sony.dtv.timers</item> -->
    <string-array name="hidden_apps">
        <item>com.sony.dtv.notificationcenter</item>
        <item>com.sony.dtv.ecodashboard</item>
        <item>com.sony.dtv.smarthelp</item>
        <item>com.sony.dtv.smartmediaapp</item>
        <item>com.sony.dtv.livingfit</item>
        <item>com.sony.dtv.seeds.iot</item>
        <item>com.sony.dtv.osat.music</item>
        <item>com.sony.dtv.timers</item>
        <item>com.google.android.videos</item>
    </string-array>

    <!-- Picture hotkeys: the remote's number keys switch the picture, in any app (Hotkeys.java). Each
         profile is its name, then settings for Sony's picture API as target=value. pictureMode is one of
         vivid, standard, cinema, game, graphics, photo, custom; brightness 0-50; contrast, color and
         sharpness 0-100; colorTemperature cool,
         neutral, warm, expert1, expert2; autoLocalDimming off, low, medium, high; lightSensor on, off.
         motionflow (auto, custom, off) isn't in the API: the key sets it in Sony's picture menu, which
         shows at the foot of the screen for a few seconds (the Apps settings only, while an app plays).
         Smoothness and Clearness stay as set by hand (Sports: Smoothness 2, Clearness Min; Max made the
         ball break up as Motionflow guessed at it).
         Game mode keeps lag low by switching off Sony's motion processing, so Gaming sets no motionflow.
         Add hotkey_6 to hotkey_9 the same way; 0 shows what each key does. -->
    <string-array name="hotkey_1">
        <item>Sports</item>
        <item>pictureMode=custom</item>
        <item>brightness=46</item>
        <item>contrast=95</item>
        <item>color=65</item>
        <item>sharpness=55</item>
        <item>colorTemperature=cool</item>
        <item>autoLocalDimming=medium</item>
        <item>lightSensor=off</item>
        <item>motionflow=custom</item>
    </string-array>
    <string-array name="hotkey_2">
        <item>Movies</item>
        <item>pictureMode=cinema</item>
        <item>brightness=42</item>
        <item>contrast=95</item>
        <item>color=58</item>
        <item>sharpness=50</item>
        <item>colorTemperature=neutral</item>
        <item>autoLocalDimming=high</item>
        <item>lightSensor=off</item>
        <item>motionflow=auto</item>
    </string-array>
    <string-array name="hotkey_3">
        <item>Gaming</item>
        <item>pictureMode=game</item>
        <item>brightness=50</item>
        <item>contrast=95</item>
        <item>color=60</item>
        <item>sharpness=50</item>
        <item>colorTemperature=neutral</item>
        <item>autoLocalDimming=medium</item>
        <item>lightSensor=off</item>
    </string-array>
    <string-array name="hotkey_4">
        <item>Night</item>
        <item>pictureMode=cinema</item>
        <item>brightness=12</item>
        <item>colorTemperature=expert1</item>
        <item>autoLocalDimming=low</item>
        <item>lightSensor=off</item>
        <item>motionflow=off</item>
    </string-array>
    <string-array name="hotkey_5">
        <item>Everyday</item>
        <item>pictureMode=standard</item>
        <item>brightness=46</item>
        <item>contrast=95</item>
        <item>color=60</item>
        <item>sharpness=52</item>
        <item>colorTemperature=neutral</item>
        <item>autoLocalDimming=medium</item>
        <item>lightSensor=off</item>
        <item>motionflow=auto</item>
    </string-array>
</resources>
