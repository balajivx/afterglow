    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shield"
        android:shortcutId="toggle_adblock"
        android:shortcutLongLabel="@string/shortcut_adblock_long"
        android:shortcutShortLabel="@string/shortcut_adblock">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.pixelcontrols.adblock.ToggleAdblockActivity"
            android:targetPackage="com.pixelcontrols" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_enhance"
        android:shortcutId="pro_enhance"
