<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- DSLR tile: read the photo you just took (Android 14+ may grant only selected photos). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- targetSdk 28: Android maps this to photo access on Android 13+ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- saving the edited copy into Pictures/PixelControls as a legacy-target app -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Android Auto wired/wireless (ported from AA Switch): switch Wi-Fi, see the car's Bluetooth -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- "In the car" notification while connected to the car -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Low signal focus: which app is on screen (usage access, granted by install.sh) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Battery watch: Android's per-app battery use (granted once over USB; may be refused to apps) -->
    <uses-permission android:name="android.permission.BATTERY_STATS" />
    <!-- re-arm the Lite adblock DNS watchdog after a restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app list launchable apps for the "bypass the filter" picker (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens this screen -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".adblock.ToggleAdblockActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_adblock"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Sound Profile tile: applies the profile from the front (Android 16+ blocks background volume changes) -->
        <activity
            android:name=".sound.SoundApplyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".photo.EnhanceActivity"
            android:exported="true"
            android:icon="@drawable/ic_enhance"
            android:label="@string/enhance_label"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter android:label="@string/enhance_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/enhance_label">
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- "Open with" in phone galleries and file managers -->
            <intent-filter android:label="@string/enhance_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".photo.DslrTileService"
            android:exported="true"
            android:icon="@drawable/ic_enhance"
            android:label="@string/enhance_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".adblock.AdblockVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name=".adblock.AdblockTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/tile_adblock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Android Auto wired <-> wireless (no helper daemon needed) -->
        <service
            android:name=".auto.AutoTileService"
            android:exported="true"
            android:icon="@drawable/ic_car"
            android:label="@string/tile_auto"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Sound Profile tile (Normal, Silent/Vibrate, Night Mode) -->
        <service
            android:name=".sound.SoundProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_sound_normal"
            android:label="@string/tile_sound_profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Phone Adaptive Brightness tile (Auto vs Manual M preset) -->
        <service
            android:name=".brightness.AdaptiveBrightnessTileService"
            android:exported="true"
            android:icon="@drawable/ic_brightness_auto"
            android:label="@string/tile_brightness_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Low Signal Boost tile (4G lock + Data/Battery Saver + DNS Accelerator) -->
        <service
            android:name=".lowsignal.LowSignalTileService"
            android:exported="true"
            android:icon="@drawable/ic_signal_low"
            android:label="@string/tile_low_signal"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".adblock.AdblockActionReceiver"
            android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".adblock.LiteDnsWatch" android:exported="false" />

        <!-- Battery watch: hourly check of apps busy in the background; "It's fine" on its notifications -->
        <service
            android:name=".battery.BatteryWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".battery.BatteryWatchReceiver" android:exported="false" />

        <!-- Android Auto: a car's Bluetooth connecting / going (works right after a restart, nothing running) -->
        <receiver android:name=".auto.CarReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <service android:name=".auto.CarService" android:exported="false" />
        <receiver android:name=".auto.CarPortReceiver" android:exported="false" />
        <!-- tests from a computer only (adb shell holds DUMP; apps can't) -->
        <receiver
            android:name=".auto.SimReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
